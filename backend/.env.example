# ==========================================
# APEX SALES AI
# ==========================================

APP_NAME=Apex Sales AI
APP_ENV=development
DEBUG=true

API_HOST=127.0.0.1
API_PORT=8000

FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000


# ==========================================
# DATABASE
# ==========================================

MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING
MONGODB_DATABASE=apex_sales
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

SQLITE_DATABASE_PATH=./data/apex_sales.sqlite3


# ==========================================
# LLM
# ==========================================

LLM_PROVIDER=omniroute
OMNIROUTE_BASE_URL=YOUR_OMNIROUTE_BASE_URL
OMNIROUTE_API_KEY=YOUR_OMNIROUTE_API_KEY
OMNIROUTE_DEFAULT_MODEL=YOUR_OMNIROUTE_MODEL
OMNIROUTE_TIMEOUT_SECONDS=60
OMNIROUTE_MAX_RETRIES=2


# ==========================================
# EMAIL
# ==========================================

EMAIL_PROVIDER=YOUR_EMAIL_PROVIDER
EMAIL_API_KEY=YOUR_EMAIL_API_KEY
EMAIL_FROM=YOUR_EMAIL_ADDRESS


# ==========================================
# WHATSAPP
# ==========================================

WHATSAPP_PROVIDER=YOUR_WHATSAPP_PROVIDER
WHATSAPP_API_KEY=YOUR_WHATSAPP_API_KEY
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID

